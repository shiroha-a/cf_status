{
  "name": "hc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "format": "biome format --write .",
    "lint": "biome check --write .",
    "db:create": "wrangler d1 create hc",
    "db:migrate:local": "wrangler d1 migrations apply hc --local",
    "db:migrate:remote": "wrangler d1 migrations apply hc --remote"
  },
  "dependencies": {
    "hono": "^4.12.23"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@cloudflare/workers-types": "^4.20260527.1",
    "typescript": "^5.7.0",
    "wrangler": "^4.95.0"
  }
}
