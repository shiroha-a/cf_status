import type { MonitorConfig } from './src/types';

/**
 * Template for monitors.config.ts. Copy to `monitors.config.ts` and edit your
 * own targets. The real monitors.config.ts is gitignored so monitored URLs are
 * not committed.
 *   cp monitors.config.ts.example monitors.config.ts
 *
 * Monitored targets (Configuration as Code).
 *
 * On every scheduled run the list is synced into D1: entries are upserted by
 * `name`, and any monitor whose `name` is absent here is disabled.
 */
export const monitors: MonitorConfig[] = [
  {
    name: 'Example',
    url: 'https://example.com',
    expectedStatus: 200,
    intervalSeconds: 60,
    sslCheck: true,
    sslWarnDays: 14,
  },
];
